# Environment Configuration
# Copy to .env and fill in values: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=techneos
POSTGRES_PASSWORD=techneos_dev_password
POSTGRES_DB=techneos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=techneos-data
MINIO_SECURE=false

# --- Valkey (Redis-compatible cache) ---
VALKEY_URL=redis://localhost:6379/0

# --- Auth ---
# No AUTH_PROVIDER needed — provider is determined per-request:
#   Email/password → local, Google/GitHub → Keycloak, SSO → OAuth2
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Gateway + portal URLs the management client scripts (build_and_register.py /
# seed scripts) target. These are the local defaults; override per environment
# in production.
PLATFORM_API_URL=http://localhost:8000
PLATFORM_PORTAL_URL=http://localhost:3000

# --- Keycloak (optional — configure to enable Google/GitHub social login) ---
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=techneos
# KEYCLOAK_CLIENT_ID=techneos-api
# KEYCLOAK_CLIENT_SECRET=change-me
# KEYCLOAK_WEB_CLIENT_ID=techneos-web
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# --- Social Login (optional — requires Keycloak) ---
# Register at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
#
# Register at https://github.com/settings/applications/new (OAuth App)
# Set callback URL to: http://localhost:8080/realms/techneos/broker/github/endpoint
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# --- Generic OAuth2 (optional — configure to enable enterprise SSO) ---
# Use this for enterprise IdPs like PingFederate, Okta, Azure AD, etc.
# OAUTH2_CLIENT_ID=your-oauth2-client-id
# OAUTH2_CLIENT_SECRET=your-oauth2-client-secret
# OAUTH2_AUTHORIZATION_URL=https://your-idp.example.com/as/authorization.oauth2
# OAUTH2_TOKEN_URL=https://your-idp.example.com/as/token.oauth2
# OAUTH2_REDIRECT_URL=https://your-app.example.com/auth/callback
# OAUTH2_SCOPES=openid
# Token introspection (if the IdP issues opaque tokens instead of JWTs)
# OAUTH2_INTROSPECT_URL=https://your-idp.example.com/as/introspect.oauth2
# OAUTH2_INTROSPECT_CLIENT_ID=your-validation-client-id
# OAUTH2_INTROSPECT_CLIENT_SECRET=your-validation-client-secret

# --- Secrets ---
# SECRETS_ENCRYPTION_KEY=  # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Python Package Server (local pypiserver for dev) ---
#
# Two URLs:
#   PYTHON_PACKAGE_PUBLISH_URL → where host-side build_and_register.py uploads wheels
#   PYTHON_PACKAGE_INDEX_URL   → where the platform installs pypi tools from
#
# The backend services run on the HOST in dev, so both point at the host-mapped
# pypiserver (localhost:3141). When a pypi tool is dispatched, core.packaging
# rewrites localhost -> host.docker.internal so the spawned tool container can
# still reach it (see core/packaging.py rewrite_url_for_tool_container). Only set
# the INDEX url to the compose service name (http://devpi:8080/) if you instead
# run the backend services INSIDE compose.
#
# In production this is replaced by a hosted index (e.g. AWS CodeArtifact).
PYTHON_PACKAGE_PUBLISH_URL=http://localhost:3141/
PYTHON_PACKAGE_INDEX_URL=http://localhost:3141/simple/
PYTHON_PACKAGE_USERNAME=devpi
PYTHON_PACKAGE_PASSWORD=devpi

# --- Docker Network ---
# Explicitly names the Compose default network so Airflow-launched tool
# containers can join it and resolve services by hostname.
# DOCKER_NETWORK_NAME=techneos
