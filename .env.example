# Environment Configuration
# Copy to .env and fill in values: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=techneos
POSTGRES_PASSWORD=techneos_dev_password
POSTGRES_DB=techneos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=techneos-data
MINIO_SECURE=false

# --- Valkey (Redis-compatible cache) ---
VALKEY_URL=redis://localhost:6379/0

# --- Auth ---
# No AUTH_PROVIDER needed — provider is determined per-request:
#   Email/password → local, Google/GitHub → Keycloak, SSO → OAuth2
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Gateway + portal URLs the management client scripts (build_and_register.py /
# seed scripts) target. These are the local defaults; override per environment
# in production.
PLATFORM_API_URL=http://localhost:8000
PLATFORM_PORTAL_URL=http://localhost:3000

# --- Seed defaults (make seed) ---
# Initial org, team, and admin user created by `make seed`. Uncomment to
# override the values baked into setup/database/.techneos.*.json. DEFAULT_ORG_SLUG
# is also how the auth service resolves a user's default org, so keep them aligned.
# DEFAULT_ORG_NAME=Default Organization
# DEFAULT_ORG_SLUG=default
# DEFAULT_TEAM_NAME=Default Team
# DEFAULT_TEAM_SLUG=default-team
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=changeme123
# DEFAULT_ADMIN_FULL_NAME=Admin User
# DEFAULT_ADMIN_ROLE=platform_admin

# --- LLM provider (make register-platform-assistant) ---
# Default LLM provider for the built-in Platform Assistant. Fields default from
# setup/database/.techneos.*.json; set the API key here (it never lives in a
# committed file). Without DEFAULT_LLM_API_KEY, Platform Assistant registration
# is skipped — a keyless provider can't serve the assistant.
# DEFAULT_LLM_API_KEY=
# DEFAULT_LLM_NAME=TechneOS Gemini
# DEFAULT_LLM_SLUG=techneos-gemini
# DEFAULT_LLM_PROVIDER_TYPE=openai_compatible
# DEFAULT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# DEFAULT_LLM_DEFAULT_MODEL=gemini-2.5-pro
# DEFAULT_LLM_MAX_TOKENS=8192

# --- Services ---
# Fixed, contiguous ports per service (8000-8008). The gateway is the only
# public entry point; the rest are reachable internally at their *_SERVICE_URL.
GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
AUTH_SERVICE_URL=http://localhost:8001
DATASET_SERVICE_PORT=8002
DATASET_SERVICE_URL=http://localhost:8002
TOOL_SERVICE_PORT=8003
TOOL_SERVICE_URL=http://localhost:8003
PIPELINE_SERVICE_PORT=8004
PIPELINE_SERVICE_URL=http://localhost:8004
AGENT_SERVICE_PORT=8005
AGENT_SERVICE_URL=http://localhost:8005
NOTIFICATION_SERVICE_PORT=8006
NOTIFICATION_SERVICE_URL=http://localhost:8006
APP_SERVICE_PORT=8007
APP_SERVICE_URL=http://localhost:8007
TASK_SERVICE_PORT=8008
TASK_SERVICE_URL=http://localhost:8008

# --- Keycloak (optional — configure to enable Google/GitHub social login) ---
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=techneos
# KEYCLOAK_CLIENT_ID=techneos-api
# KEYCLOAK_CLIENT_SECRET=change-me
# KEYCLOAK_WEB_CLIENT_ID=techneos-web
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# --- Social Login (optional — requires Keycloak) ---
# Register at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
#
# Register at https://github.com/settings/applications/new (OAuth App)
# Set callback URL to: http://localhost:8080/realms/techneos/broker/github/endpoint
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# --- Generic OAuth2 (optional — configure to enable enterprise SSO) ---
# Use this for enterprise IdPs like PingFederate, Okta, Azure AD, etc.
# OAUTH2_CLIENT_ID=your-oauth2-client-id
# OAUTH2_CLIENT_SECRET=your-oauth2-client-secret
# OAUTH2_AUTHORIZATION_URL=https://your-idp.example.com/as/authorization.oauth2
# OAUTH2_TOKEN_URL=https://your-idp.example.com/as/token.oauth2
# OAUTH2_REDIRECT_URL=https://your-app.example.com/auth/callback
# OAUTH2_SCOPES=openid
# Token introspection (if the IdP issues opaque tokens instead of JWTs)
# OAUTH2_INTROSPECT_URL=https://your-idp.example.com/as/introspect.oauth2
# OAUTH2_INTROSPECT_CLIENT_ID=your-validation-client-id
# OAUTH2_INTROSPECT_CLIENT_SECRET=your-validation-client-secret

# --- Airflow (pipeline orchestration) ---
# The airflow services in docker-compose.yml start with the rest of the stack.
# AIRFLOW_BASE_URL connects the pipeline service to Airflow — without it,
# submitted runs stay in "pending" status. The webserver is on :8082.
AIRFLOW_BASE_URL=http://localhost:8082
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_WEBSERVER_SECRET_KEY=techneos-airflow-dev-secret-key
AIRFLOW_DAG_ID=techneos_airflow_pipeline
PLATFORM_CALLBACK_URL=http://host.docker.internal:8000
# Shared secret the Airflow DAG uses to authenticate status callbacks to the
# platform (the gateway's X-Internal-Token). Generate a random value.
INTERNAL_SERVICE_TOKEN=change-me-generate-a-random-secret

# --- Apps ---
# Deployer backend for embedded Apps. Only `docker` is implemented today
# (a `kubernetes` backend is reserved for a future release).
# APP_DEPLOYER_BACKEND=docker

# Hostname the app-service uses to reach containers it deploys via Docker.
# Default `host.docker.internal` is correct when app-service runs in a
# container (docker-compose / EC2). For local dev where uvicorn runs on
# the host directly, set to `localhost` — host.docker.internal doesn't
# resolve from the host on macOS.
# APP_DEPLOYER_HOST=host.docker.internal

# Cookie Domain for the platform's session cookie (techneos_access_token).
# Leave empty in local dev — cookies scope to the request host
# (localhost), which is shared across ports so it works between the web
# frontend and the gateway.
# In prod with a subdomain split (e.g. techneos.example.com for the web and
# techneosapi.example.com for the API), set to ".example.com" (note the leading
# dot) so the cookie is sent to both subdomains. **Required for embedded
# Apps to load — the iframe authenticates via this cookie.**
# SESSION_COOKIE_DOMAIN=

# --- Secrets ---
# SECRETS_ENCRYPTION_KEY=  # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Compute Backend ---
# Which backend the Airflow DAG uses to execute pipeline steps: docker | aws_batch
# COMPUTE_BACKEND=docker

# --- AWS Batch (optional — for cloud-based pipeline execution) ---
# AWS_REGION=us-east-1
# AWS_BATCH_JOB_QUEUE=techneos-job-queue
# AWS_BATCH_JOB_DEFINITION=techneos-tool-job
# AWS_BATCH_WORK_BUCKET=techneos-aws-batch-shared-data
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# --- Python Package Server (local pypiserver for dev) ---
#
# Two URLs:
#   PYTHON_PACKAGE_PUBLISH_URL → where host-side build_and_register.py uploads wheels
#   PYTHON_PACKAGE_INDEX_URL   → where the platform installs pypi tools from
#
# The backend services run on the HOST in dev, so both point at the host-mapped
# pypiserver (localhost:3141). When a pypi tool is dispatched, core.packaging
# rewrites localhost -> host.docker.internal so the spawned tool container can
# still reach it (see core/packaging.py rewrite_url_for_tool_container). Only set
# the INDEX url to the compose service name (http://devpi:8080/) if you instead
# run the backend services INSIDE compose.
#
# In production this is replaced by a hosted index (e.g. AWS CodeArtifact).
PYTHON_PACKAGE_PUBLISH_URL=http://localhost:3141/
PYTHON_PACKAGE_INDEX_URL=http://localhost:3141/simple/
PYTHON_PACKAGE_USERNAME=devpi
PYTHON_PACKAGE_PASSWORD=devpi

# --- Docker Network ---
# Explicitly names the Compose default network so Airflow-launched tool
# containers can join it and resolve services by hostname.
# DOCKER_NETWORK_NAME=techneos
