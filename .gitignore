# Environment variables (copy .env.example -> .env)
.env
.env.local
.env.*.local
# Filled-in per-environment deploy secrets — every production secret lives in
# these, never committable. The only env files in git are the *.example
# templates (.env.prod.example, ...). Covers deploy/ec2/.env.prod,
# environments/*.env, .env.staging, and the like.
.env.prod
.env.*.prod
*.env.prod
.env.staging
.env.*.staging
environments/

# `make backup` output — database dumps and bucket contents, i.e. real user
# data and secrets. Never committable.
backups/

# Python bytecode & build artifacts
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/

# Virtual environments
.venv/
venv/

# Tooling caches (Ruff, mypy, pytest — all configured in pyproject.toml)
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage

# Docker
docker-compose.override.yml

# bin/dev.sh runtime state
.dev-logs/
.dev-pids/
.dev-tmp/

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Coding-agent workspace
.claude/
