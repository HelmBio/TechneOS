# Production environment for a EC2 deployment.
#
#   cp deploy/ec2/.env.prod.example deploy/ec2/.env.prod
#   # fill in every <placeholder>, then:
#   ./deploy/deploy.sh --env-file environments/prod.env
#
# deploy.sh renders this into /data/techneos/.env on the host. Keep your filled-in
# copy out of the repo — environments/ is gitignored.
#
# Generate each secret below with the command shown beside it. Anything marked
# REQUIRED has no default: compose stops and names the variable rather than
# starting the platform with a development password.

# --- Release ---------------------------------------------------------------
# There is no global image tag. Each image is tagged with its own package
# version (from pyproject.toml / package.json); build-and-push.sh publishes
# `techneos/<svc>:<version>`, and deploy.sh pins each service to that version on
# the host. To roll back or hold ONE service at a different build, set its
# override here — it wins over the auto-pinned version:
#   GATEWAY_IMAGE_TAG, AUTH_SERVICE_IMAGE_TAG, DATASET_SERVICE_IMAGE_TAG,
#   TOOL_SERVICE_IMAGE_TAG, TASK_SERVICE_IMAGE_TAG, PIPELINE_SERVICE_IMAGE_TAG,
#   AGENT_SERVICE_IMAGE_TAG, APP_SERVICE_IMAGE_TAG, NOTIFICATION_SERVICE_IMAGE_TAG,
#   PORTAL_IMAGE_TAG, TOOL_RUNTIME_IMAGE_TAG
# e.g. AUTH_SERVICE_IMAGE_TAG=0.1.0  (or a specific immutable build 0.1.0-<rev>).

# REQUIRED. Container image registry, without a trailing slash. ECR today;
# the reference is registry-neutral, so switching means changing this value
# and the login step in remote-deploy.sh — e.g. ghcr.io/<org> for GHCR. The
# wheel index (PYTHON_PACKAGE_INDEX_URL below) is a separate choice: GitHub
# has no PyPI index, so images and wheels can live in different registries.
#   ECR:  <account>.dkr.ecr.<region>.amazonaws.com
#   GHCR: ghcr.io/<org>
DOCKER_IMAGE_REGISTRY=<account>.dkr.ecr.<region>.amazonaws.com
# For ECR, the region is derived from the registry host above; this value is
# used only for non-ECR registries.
AWS_REGION=us-east-1

# --- Public URLs -----------------------------------------------------------
# REQUIRED. The API's public base URL. Three things read it, and they must
# agree: Keycloak's token issuer, the portal's build-time API URL, and CORS.
PLATFORM_API_URL=https://<api-host>

# REQUIRED. The portal's public base URL. Substituted into the Keycloak realm's
# redirect URIs / web origins at import.
PLATFORM_PORTAL_URL=https://<portal-host>

# REQUIRED. Which origins the gateway accepts — the portal's URL.
CORS_ORIGINS=https://<portal-host>

# REQUIRED. Where clients follow presigned object-storage URLs. This is the
# public edge (nginx proxies /storage to minio), not the compose service.
# A bare host or a full https://host URL both work.
MINIO_PUBLIC_ENDPOINT=<api-host>

# Set only if the portal and API are subdomains of one parent and you want the
# session cookie shared across them, e.g. .example.com
SESSION_COOKIE_DOMAIN=

# Contact address certbot registers the TLS cert under (remote-deploy.sh obtains
# one Let's Encrypt cert covering both hosts). Leave blank to deploy HTTP-only
# and add TLS later — nginx then serves plain :80 until a cert exists.
CERTBOT_EMAIL=

PLATFORM_SITE_NAME=TechneOS
PLATFORM_SITE_TAGLINE=

# --- Secrets ---------------------------------------------------------------
# REQUIRED — openssl rand -hex 32
POSTGRES_PASSWORD=<openssl rand -hex 32>
# REQUIRED — openssl rand -hex 32
JWT_SECRET_KEY=<openssl rand -hex 32>
# REQUIRED — openssl rand -hex 32. Shared secret for service-to-service calls.
INTERNAL_SERVICE_TOKEN=<openssl rand -hex 32>
# REQUIRED — python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts API keys and bucket credentials at rest. Changing it strands
# everything already encrypted with the old one.
SECRETS_ENCRYPTION_KEY=<fernet-key>
# REQUIRED — openssl rand -hex 32
MINIO_ROOT_PASSWORD=<openssl rand -hex 32>
# REQUIRED — openssl rand -hex 32
KEYCLOAK_ADMIN_PASSWORD=<openssl rand -hex 32>
# REQUIRED — openssl rand -hex 32
AIRFLOW_PASSWORD=<openssl rand -hex 32>
# REQUIRED — openssl rand -hex 32
AIRFLOW_WEBSERVER_SECRET_KEY=<openssl rand -hex 32>

POSTGRES_USER=techneos
POSTGRES_DB=techneos
MINIO_ROOT_USER=minioadmin
MINIO_BUCKET=techneos-data
KEYCLOAK_ADMIN=admin
AIRFLOW_USERNAME=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Keycloak / SSO --------------------------------------------------------
# The realm and its clients come from deploy/keycloak/. The values below are
# substituted into the realm on Keycloak's FIRST boot only — afterwards the
# realm lives in the database and this file is not read again. Rotate with
# bin/sync-keycloak-idp-secrets.sh.
KEYCLOAK_REALM=techneos
KEYCLOAK_CLIENT_ID=techneos-api
KEYCLOAK_WEB_CLIENT_ID=techneos-web
KEYCLOAK_CLIENT_SECRET=<openssl rand -hex 32>

# Leave blank to run without social login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Seed + assistant registration ------------------------------------------
# The default org, team, and admin `seed` creates on a fresh database. These
# apply only on the FIRST seed of an empty DB (seed is add-if-absent — it won't
# rename an org/team or move an admin that already exists). DEFAULT_ORG_SLUG is
# also how the auth service resolves a user's default org, so keep it stable.
DEFAULT_ORG_NAME=Default Organization
DEFAULT_ORG_SLUG=default
DEFAULT_TEAM_NAME=Default Team
DEFAULT_TEAM_SLUG=default

# The admin user `seed` creates and that deploy.sh logs in as to register the
# built-in assistant. SET THESE for production: left blank, seed falls back to
# the committed example credentials (admin@example.com / changeme123).
DEFAULT_ADMIN_EMAIL=<admin@your-org.com>
DEFAULT_ADMIN_PASSWORD=<openssl rand -hex 24>
DEFAULT_ADMIN_FULL_NAME=Admin User

# The Platform Assistant's LLM provider. `seed` creates it in-container from
# these values (the key is Fernet-encrypted at rest, so SECRETS_ENCRYPTION_KEY
# must be set); deploy.sh then registers the assistant agent against it. A blank
# DEFAULT_LLM_API_KEY skips the provider (the platform still runs, just without
# the built-in assistant). The key never lives in a committed file. The other
# DEFAULT_LLM_* fields default from migrations/seed/seed.defaults.json — override
# here only to change provider.
DEFAULT_LLM_API_KEY=
# DEFAULT_LLM_NAME=TechneOS Gemini
# DEFAULT_LLM_SLUG=techneos-gemini
# DEFAULT_LLM_PROVIDER_TYPE=openai_compatible
# DEFAULT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# DEFAULT_LLM_DEFAULT_MODEL=gemini-2.5-pro
# DEFAULT_LLM_MAX_TOKENS=8192

# --- Python package index (CodeArtifact) ------------------------------------
# Credential-free base URL — no token here, and nothing to rotate. The Airflow
# worker mints one per install from the instance's IAM role, which therefore
# needs codeartifact:GetAuthorizationToken, codeartifact:ReadFromRepository,
# sts:GetServiceBearerToken and codeartifact:ListPackages (the gateway lists
# packages for the synthesized /simple/ root index).
#
# Without this, the platform runs but no pypi-type tool or agent package can be
# installed — i.e. no catalog content.
#   https://<domain>-<account>.d.codeartifact.<region>.amazonaws.com/pypi/<repo>/simple/
PYTHON_PACKAGE_INDEX_URL=

# Used by the gateway when publishing wheels (it mints its own
# token from whatever credentials the operator runs with).
#   https://<domain>-<account>.d.codeartifact.<region>.amazonaws.com/pypi/<repo>/
PYTHON_PACKAGE_PUBLISH_URL=

# Credentials for package index (CodeArtifact uses "aws" + minted token)
PYTHON_PACKAGE_USERNAME=aws
PYTHON_PACKAGE_PASSWORD=

# --- CodeArtifact Settings (for token minting) ---
# When set, the gateway mints fresh tokens for publishing instead of using
# static credentials. Only needed for CodeArtifact deployments.
CODEARTIFACT_DOMAIN=
CODEARTIFACT_DOMAIN_OWNER=
CODEARTIFACT_REPOSITORY=

# --- Docker Image Registry (for pushing container tool images) ---
# Empty for local dev (images stay in local daemon).
# Set to ECR URL for prod (e.g. 123456789.dkr.ecr.us-east-1.amazonaws.com).
# Authentication is via IAM (Docker daemon login), not username/password.

# --- Execution -------------------------------------------------------------
# docker runs tool containers on this same host, beside everything else. That
# contention is the practical limit on a single instance.
COMPUTE_BACKEND=docker
APP_DEPLOYER_BACKEND=docker
APP_DEPLOYER_HOST=host.docker.internal

# Must match the compose network name; the scheduler attaches tool containers
# to it by name.
DOCKER_NETWORK_NAME=techneos

# Host directory the scheduler shares with the tool containers it starts.
TECHNEOS_HOST_SHARED_INPUT_DIR=/data/techneos/airflow-inputs

AIRFLOW_DAG_ID=techneos_airflow_pipeline
AIRFLOW_TASK_RETRIES=1
AIRFLOW_RETRY_DELAY_MINUTES=1
AIRFLOW_EXECUTION_TIMEOUT_HOURS=24

LOG_LEVEL=INFO

# --- Deploy target (read by deploy/deploy.sh, not by the platform) ----------
SSH_HOST=<instance-hostname-or-ip>
SSH_USER=deploy
SSH_KEY_PATH=~/.ssh/<key>.pem
SSH_PORT=22
REMOTE_DIR=/data/techneos
