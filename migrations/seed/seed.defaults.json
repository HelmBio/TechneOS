{
  "roles": [
    {
      "name": "platform_admin",
      "description": "Full platform access",
      "permissions": ["*:*:platform"]
    },
    {
      "name": "org_admin",
      "description": "Full access within organization",
      "permissions": ["*:*:org"]
    },
    {
      "name": "project_lead",
      "description": "Manage datasets and pipelines for team",
      "permissions": [
        "agent:read:team",
        "agentic-run:*:team",
        "agentic-task:*:team",
        "dataset:*:team",
        "pipeline:*:team",
        "pipeline-run:*:team",
        "tool-run:*:team",
        "task-run:*:team",
        "tool:read:team",
        "app:*:team",
        "user:read:team",
        "result:*:team"
      ]
    },
    {
      "name": "scientist",
      "description": "Run pipelines and view team data",
      "permissions": [
        "agent:read:team",
        "agentic-run:read:own",
        "agentic-run:execute:own",
        "agentic-task:read:own",
        "agentic-task:execute:own",
        "agentic-task:update:own",
        "app:read:team",
        "dataset:create:own",
        "dataset:read:team",
        "pipeline:execute:own",
        "pipeline:read:team",
        "pipeline-run:read:own",
        "pipeline-run:execute:own",
        "pipeline-run:update:own",
        "tool-run:read:own",
        "tool-run:execute:own",
        "tool-run:update:own",
        "task-run:read:own",
        "task-run:update:own",
        "tool:read:team",
        "result:read:team"
      ]
    },
    {
      "name": "viewer",
      "description": "Read-only access to own data",
      "permissions": ["*:read:own"]
    }
  ],
  "org": {
    "name": "Default Organization",
    "slug": "default",
    "settings": {}
  },
  "team": {
    "name": "Default Team"
  },
  "admin_user": {
    "email": "admin@example.com",
    "password": "changeme123",
    "full_name": "Admin User",
    "role": "platform_admin"
  },
  "llm_provider": {
    "name": "TechneOS Gemini",
    "slug": "techneos-gemini",
    "provider_type": "openai_compatible",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "default_model": "gemini-2.5-pro",
    "supported_models": ["gemini-2.5-pro", "gemini-2.0-flash", "gemini-2.0-flash-lite"],
    "max_tokens": 8192,
    "is_default": true
  }
}
