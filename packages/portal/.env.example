# ─── Environment Template ──────────────────────────────────────────────────
# .env.development isn't committed — copy this file to create it once:
#   cp .env.example .env.development
#
# .env.production IS committed and hand-maintained directly (not copied from
# here). See its own header comment and packages/portal/.gitignore.
#
# Next.js auto-loads the right file based on NODE_ENV:
#   .env.development  → next dev
#   .env.production   → next build (production mode)
#
# None of the values below are secret — this file documents client-bundle
# config, not credentials.

# ── Login Buttons ─────────────────────────────────────────────────────────
# Set to "true" to show the button, anything else to hide.
NEXT_PUBLIC_LOGIN_SSO=false
NEXT_PUBLIC_LOGIN_GOOGLE=true
NEXT_PUBLIC_LOGIN_GITHUB=true

# ── Session / Token Management ────────────────────────────────────────────
# All values in seconds.
NEXT_PUBLIC_SESSION_CHECK_INTERVAL=200
NEXT_PUBLIC_SESSION_WARN_BEFORE=1800
NEXT_PUBLIC_SESSION_AUTO_REFRESH_BEFORE=300
NEXT_PUBLIC_SESSION_AUTO_REFRESH_ACTIVE=300
